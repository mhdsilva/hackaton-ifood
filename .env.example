# Copie para .env (que nunca é versionado) e preencha.
# Credenciais do agente: https://mcp-developer.ifood.com.br → Meus agentes.
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=

# Apresentação: mantém MCP e carrinho reais, mas não envia nem cobra pedidos.
# Valores: simulated (apresentação) ou ifood (envio real após consentimento).
CHECKOUT_MODE=simulated

# Precisa ser idêntica a uma Redirect URL cadastrada no agente (só a porta pode variar em
# localhost). A API atende no caminho desta URL, então rode a API na porta do valor abaixo
# (ex.: PORT=8080) ou ajuste a URL para a porta da API (padrão 3333). Em modo demo o callback
# é http://localhost:<PORT>/mcp-connection/callback.
IFOOD_REDIRECT_URI=http://localhost:8080/callback

# Preenchidos por `npm run ifood:login` e renovados por `npm run ifood:refresh`.
IFOOD_ACCESS_TOKEN=
IFOOD_REFRESH_TOKEN=
IFOOD_ACCESS_TOKEN_EXPIRES_AT=

# LLM do agente (opcional). Sem chave, o agente usa o pipeline determinístico.
# Chave em https://opencode.ai/console. Endpoint OpenAI-compatible.
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4.1-flash
OPENCODE_BASE_URL=https://opencode.ai/inference
