{
  "name": "sidequest-party",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @sidequest/contracts && npm run build --workspace @sidequest/api",
